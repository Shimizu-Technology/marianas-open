# Clerk authentication (required for local admin sign-in)
# These values must belong to the same Clerk development application as the
# frontend's VITE_CLERK_PUBLISHABLE_KEY.
CLERK_JWKS_URL=https://your-development-clerk-domain/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_your-development-secret-key

# App URLs (the shown local values are also the development defaults)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_FRONTEND_URL=http://localhost:5173

# Invitation email (required to send or resend admin invitations)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL="Marianas Open <noreply@example.com>"

# General Translation (required only for automated translations)
GT_API_KEY=gtx-dev-your-dev-key
GT_PROJECT_ID=your-project-id

# S3 uploads (required only when ACTIVE_STORAGE_SERVICE=amazon)
# Local development uses disk storage by default.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=your-development-bucket
# ACTIVE_STORAGE_SERVICE=amazon

# Commerce storefront. Keep disabled until the environment is intentionally
# configured with isolated test or live payment and shipping credentials.
COMMERCE_ENABLED=false
# Use an EasyPost test key outside production. When no key is available, local
# developers may opt into deterministic UI-only estimates with the second flag.
EASYPOST_API_KEY=EZTK_your-test-key
EASYPOST_WEBHOOK_SECRET=your-test-webhook-hmac-secret
EASYPOST_FAKE_RATES=false

# Stripe Checkout. Prefer a least-privilege restricted key (rk_) and use a
# separate test key outside production. The fake checkout is an explicit
# development-only browser-testing aid and is ignored in staging.
STRIPE_API_KEY=rk_test_your-restricted-key
STRIPE_WEBHOOK_SECRET=whsec_your-test-webhook-secret
STRIPE_FAKE_CHECKOUT=false

# Paid-order notifications use a durable outbox and Resend idempotency keys.
# Keep disabled locally, use sandbox with an approved resend.dev test address
# for provider QA, and use live only in the production environment.
COMMERCE_EMAIL_DELIVERY_MODE=disabled
COMMERCE_EMAIL_SANDBOX_TO=delivered+marianas-open@resend.dev
COMMERCE_OPERATIONS_EMAILS=orders@your-domain.com
COMMERCE_SUPPORT_EMAIL=moguam@marianasopen.com
