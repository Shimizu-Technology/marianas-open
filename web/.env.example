VITE_API_URL=http://localhost:3000

# Clerk Authentication
# Use the publishable key from the same Clerk development application as the
# API's CLERK_JWKS_URL and CLERK_SECRET_KEY.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-development-publishable-key

# ── Analytics (PostHog) ────────────────────────────────────────────────────
# Add these in local/prod env to enable analytics.
VITE_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_KEY
# US cloud (default): https://us.i.posthog.com
# EU cloud option:    https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── General Translation (GT) ──────────────────────────────────────────────
# Required for `npm run translate` to auto-translate locale files.
# Get keys at https://dash.generaltranslation.com
# Dev key (gtx-dev-*) for local development; Prod key (gtx-api-*) for CI/CD.
# GT_API_KEY=gtx-dev-your-dev-key
# GT_PROJECT_ID=your-project-id
# Error monitoring: optional browser project DSN, baked in at build time.
# Empty = disabled. No session replay or performance tracing is enabled.
VITE_SENTRY_DSN=
# Override Vite's mode (usually production); e.g. staging for preview builds.
# VITE_SENTRY_ENVIRONMENT=production
# Release/build identity comes from COMMIT_REF (Netlify), then GITHUB_SHA,
# otherwise a build timestamp. No Sentry auth token is needed.
