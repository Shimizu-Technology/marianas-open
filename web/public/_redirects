# SEO files - serve directly
/robots.txt    /robots.txt    200
/sitemap.xml   /sitemap.xml   200

# PWA files - serve directly
/manifest.json /manifest.json 200
/sw.js         /sw.js         200
/offline.html  /offline.html  200

# Existing assets shadow this unforced rule; missing chunks must never get index.html.
/assets/* /asset-not-found.html 404

# SPA fallback
/*    /index.html   200
