# Non-secret runtime settings. Secrets live in the macOS login keychain.
IMAGE_TAG=staging
# Keep Docker on loopback; use Tailscale Serve to expose this port to the Mac mini.
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_PORT=8788
DOCKER_CONTEXT=colima-marianas-open-staging
PULL_POLICY=always
# Required for authenticated admin access; use the same Clerk instance as the web publishable key.
CLERK_JWKS_URL=https://your-clerk-frontend-api/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-frontend-api
COMMERCE_ENABLED=false
COMMERCE_POC_MODE=false
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
